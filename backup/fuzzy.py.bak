"""
Fuzzy match verification — compares caller-supplied identity data against SOR values.

Uses rapidfuzz for Jaro-Winkler string similarity plus a normalisation layer that:
  - expands common address abbreviations (St → Street, Rd → Road, etc.)
  - handles different word orderings via token_sort_ratio
  - does exact match (after normalisation) for postcodes and DOBs
  - NEW: Phonetic matching (Soundex) for names to handle STT misspellings
  - NEW: Voice artifact cleaning (converting spoken numbers/symbols)
"""

import re
import logging
from dataclasses import dataclass
from datetime import datetime
from typing import Optional

from rapidfuzz import fuzz
from dateutil import parser as dateutil_parser

logger = logging.getLogger(__name__)

# ── Voice Artifact Mappings ──────────────────────────────────────────────────

SPOKEN_NUMBERS = {
    "zero": "0", "one": "1", "two": "2", "three": "3", "four": "4",
    "five": "5", "six": "6", "seven": "7", "eight": "8", "nine": "9",
    "ten": "10", "double": "x2", "triple": "x3", "oh": "0"
}

SPOKEN_SYMBOLS = {
    "dash": "-", "hyphen": "-", "slash": "/", "forward slash": "/",
    "backslash": "\\", "dot": ".", "point": ".", "space": " ",
}

# ── Nickname Mappings ─────────────────────────────────────────────────────────
COMMON_NICKNAMES = {
    "john": ["jonathan", "johnny", "jon"],
    "jonathan": ["john", "jon"],
    "william": ["bill", "will", "billy", "liam"],
    "richard": ["dick", "rick", "richy"],
    "robert": ["bob", "rob", "bobby"],
    "elizabeth": ["liz", "beth", "eliza", "betty"],
    "mike": ["michael"],
    "michael": ["mike"],
    "chris": ["christopher", "christina"],
    "christopher": ["chris"],
}

# ── Field-level thresholds ─────────────────────────────────────────────────────

THRESHOLDS: dict[str, float] = {
    "first_name": 85.0,
    "last_name":  85.0,
    "address_line1": 78.0,
    "postcode": 90.0,         # slightly lower for voice (95 -> 90)
    "date_of_birth": 100.0,
    "adviser_firm_name": 80.0,
    "adviser_address_line1": 75.0,
    "adviser_postcode": 90.0,
}

# ── Normalisation helpers ──────────────────────────────────────────────────────

def _clean_voice_artifacts(text: str) -> str:
    """Convert spoken numbers and symbols to canonical forms."""
    text = text.lower().strip()
    # Handle "double" and "triple" (e.g. "double seven" -> "77")
    words = text.split()
    new_words = []
    skip = 0
    for i, w in enumerate(words):
        if skip > 0:
            skip -= 1
            continue
        if w == "double" and i + 1 < len(words):
            target = SPOKEN_NUMBERS.get(words[i+1], words[i+1])
            new_words.append(target * 2)
            skip = 1
        elif w == "triple" and i + 1 < len(words):
            target = SPOKEN_NUMBERS.get(words[i+1], words[i+1])
            new_words.append(target * 3)
            skip = 1
        else:
            new_words.append(SPOKEN_NUMBERS.get(w, SPOKEN_SYMBOLS.get(w, w)))
    
    return "".join(new_words) if any(x in text for x in SPOKEN_NUMBERS) else " ".join(new_words)


def _soundex(name: str) -> str:
    """Simple Soundex implementation for phonetic matching."""
    if not name: return ""
    name = name.upper()
    first = name[0]
    tail = name[1:]
    
    # Mappings
    mapping = {
        'BFPV': '1', 'CGJKQSXZ': '2', 'DT': '3', 'L': '4', 'MN': '5', 'R': '6'
    }
    
    def get_code(char):
        for k, v in mapping.items():
            if char in k: return v
        return '0'

    codes = [get_code(c) for c in tail]
    # Remove duplicates
    final_codes = []
    last = get_code(first)
    for c in codes:
        if c != last and c != '0':
            final_codes.append(c)
        last = c
    
    return (first + "".join(final_codes) + "000")[:4]


def _expand_abbreviations(text: str) -> str:
    tokens = re.split(r"[\s,]+", text)
    return " ".join(ADDR_ABBREVS.get(t.lower().rstrip("."), t.lower().rstrip(".")) for t in tokens)


def _normalise_name(name: str) -> str:
    return name.lower().strip()


def _normalise_address(addr: str) -> str:
    # First handle spoken numbers if they exist
    addr = _clean_voice_artifacts(addr)
    return _expand_abbreviations(addr.lower().strip())


# Common ASR confusions for postcodes
POSTCODE_ASR_CONFUSIONS = {
    "88": "AA",
    "8": "A",
    "S": "F",
    "F": "S",
    "0": "O",
    "O": "0"
}

def _normalise_postcode(postcode: str) -> str:
    # Handle "oh" vs "zero" etc
    postcode = _clean_voice_artifacts(postcode)
    postcode = re.sub(r"\s+", "", postcode).upper()
    return postcode


def _compare_postcodes(nc: str, ns: str) -> float:
    """Compare postcodes with awareness of common ASR errors."""
    base_score = fuzz.ratio(nc, ns)
    if base_score >= 90.0:
        return base_score

    # Try common substitutions
    alt_nc = nc
    for search, replace in POSTCODE_ASR_CONFUSIONS.items():
        if search in alt_nc and search not in ns: # Only replace if it helps match SoR
             if replace in ns:
                 alt_nc = alt_nc.replace(search, replace)
    
    return max(base_score, fuzz.ratio(alt_nc, ns))


def _normalise_dob(dob_str: str) -> Optional[str]:
    dob_str = dob_str.strip()
    # Check if it's already YYYY-MM-DD
    if re.match(r"^\d{4}-\d{2}-\d{2}$", dob_str):
        return dob_str
    try:
        # dateutil handles "22nd August 1975" quite well
        dt = dateutil_parser.parse(dob_str, dayfirst=True, fuzzy=True)
        return dt.strftime("%Y-%m-%d")
    except (ValueError, OverflowError):
        return None


# ── Per-field comparison ───────────────────────────────────────────────────────

@dataclass
class FieldResult:
    field: str
    caller_value: str
    sor_value: str
    normalised_caller: str
    normalised_sor: str
    score: float
    threshold: float
    passed: bool
    phonetic_match: bool = False


def _compare_field(field: str, caller_val: str, sor_val: str) -> FieldResult:
    threshold = THRESHOLDS.get(field, 85.0)
    phonetic_match = False

    if field == "date_of_birth":
        nc = _normalise_dob(caller_val) or caller_val
        ns = _normalise_dob(sor_val) or sor_val
        passed = nc == ns
        score = 100.0 if passed else 0.0

    elif field == "postcode" or field == "adviser_postcode":
        nc = _normalise_postcode(caller_val)
        ns = _normalise_postcode(sor_val)
        score = _compare_postcodes(nc, ns)
        passed = score >= threshold

    elif field == "address_line1" or field == "adviser_address_line1":
        nc = _normalise_address(caller_val)
        ns = _normalise_address(sor_val)
        score = fuzz.token_sort_ratio(nc, ns)
        passed = score >= threshold

    else:  # first_name, last_name, adviser_firm_name
        nc = _normalise_name(caller_val)
        ns = _normalise_name(sor_val)
        
        # Check Nickname Map (case-insensitive)
        nick_match = False
        if field == "first_name":
            if ns in COMMON_NICKNAMES.get(nc, []) or nc in COMMON_NICKNAMES.get(ns, []):
                nick_match = True

        score = 100.0 if nick_match else fuzz.WRatio(nc, ns)
        
        # Add Phonetic check for names if WRatio is slightly below threshold
        if not nick_match and score < threshold:
            if _soundex(nc) == _soundex(ns):
                phonetic_match = True
                score = max(score, threshold)
        
        passed = score >= threshold

    return FieldResult(
        field=field,
        caller_value=caller_val,
        sor_value=sor_val,
        normalised_caller=nc,
        normalised_sor=ns,
        score=score,
        threshold=threshold,
        passed=passed,
        phonetic_match=phonetic_match
    )


# ── Full verification ──────────────────────────────────────────────────────────

@dataclass
class VerificationResult:
    verified: bool
    results: dict[str, FieldResult]
    failed_fields: list[str]

    def summary(self) -> str:
        lines = [f"Verification {'PASSED' if self.verified else 'FAILED'}"]
        for name, r in self.results.items():
            status = "✓" if r.passed else "✗"
            p_note = " (PHONETIC MATCH)" if r.phonetic_match else ""
            lines.append(
                f"  {status} {name}: score={r.score:.0f}% (threshold={r.threshold:.0f}%){p_note}"
                f"  caller={r.normalised_caller!r}  sor={r.normalised_sor!r}"
            )
        return "\n".join(lines)


def verify_caller(caller_data: dict, sor_data: dict) -> VerificationResult:
    fields = list(THRESHOLDS.keys())
    results: dict[str, FieldResult] = {}

    for f in fields:
        caller_val = caller_data.get(f)
        sor_val = sor_data.get(f)
        if not caller_val or not sor_val:
            continue
        results[f] = _compare_field(f, str(caller_val), str(sor_val))

    failed = [f for f, r in results.items() if not r.passed]
    verified = len(results) > 0 and len(failed) == 0

    result = VerificationResult(verified=verified, results=results, failed_fields=failed)
    logger.info(result.summary())
    return result
